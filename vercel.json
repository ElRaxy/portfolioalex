{
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "build",
  "routes": [
    {
      "src": "/static/(.*)",
      "headers": {
        "cache-control": "public, max-age=31536000, immutable"
      },
      "continue": true
    },
    {
      "src": "/projects/(.*)",
      "headers": {
        "cache-control": "public, max-age=86400, stale-while-revalidate=604800"
      },
      "continue": true
    },
    {
      "src": "/es/?",
      "status": 308,
      "headers": {
        "Location": "/"
      }
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/.*",
      "status": 404,
      "dest": "/404.html"
    }
  ]
}
