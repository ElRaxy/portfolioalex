# Clave de Resend con permiso de envio. Se crea en https://resend.com/api-keys
# Sin prefijo REACT_APP_: asi se queda en el servidor y no entra en el bundle.
RESEND_API_KEY=

# Direccion que recibe los mensajes del formulario.
CONTACT_TO=

# Opcional. Remitente; por defecto Portfolio Alex <portfolio@strev.app>.
# El dominio tiene que estar verificado en Resend.
CONTACT_FROM=
